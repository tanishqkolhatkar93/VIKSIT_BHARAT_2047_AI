ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
# Public origin of this app (must be reachable from the internet).
# Used to build share links and og:image URLs so WhatsApp/Facebook/etc.
# can show the vision-card preview. Example: https://your-domain.com
PUBLIC_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RATE_LIMIT_PER_HOUR=10
MAX_QUESTION_CHARS=800
CACHE_TTL_SECONDS=86400
# Leave empty to use local SQLite (backend/data/pulse.db).
# For persistence on Render/Fly, set a Postgres URL, e.g. from Supabase:
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

